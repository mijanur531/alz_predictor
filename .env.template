# ─────────────────────────────────────────────────────────────
# .env.template — Copy to .env and fill in values
# NEVER commit your actual .env to git!
# ─────────────────────────────────────────────────────────────

# ── Django Core ───────────────────────────────────────────────
DEBUG=True
SECRET_KEY=django-insecure-replace-with-a-real-50char-random-key
DJANGO_SETTINGS_MODULE=alz_predictor.settings.dev

# ── Database ──────────────────────────────────────────────────
# SQLite (dev default — no DB server needed)
# DATABASE_URL=sqlite:///db.sqlite3
# PostgreSQL (production)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/alz_db

# ── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Security / Hosts ──────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
SECURE_SSL_REDIRECT=False

# ── CORS ─────────────────────────────────────────────────────
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Email ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@alzpredictor.com
STAFF_ALERT_EMAILS=staff@alzpredictor.com,doctor@alzpredictor.com

# ── App Port (Docker) ─────────────────────────────────────────
APP_PORT=8000
